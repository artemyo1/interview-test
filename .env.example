# PostgreSQL: параметры подключения
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deals_bigdata
DB_USER=logistics
DB_PASSWORD=admin

# Фиксированная дата снимка из ТЗ
AS_OF=2026-10-26

# Количество сделок для генерации
N_PRICES=300000

# Seed для ML; seed исходного SQL-генератора уже задан в synthetic.sql
ML_SEED=42

# Каталог для модели и метаданных
MODEL_DIR=artifacts